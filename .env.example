APP_NAME=Hostbin
BASE_URL=https://hostbin.example.com
MAX_PASTE_BYTES=1048576
HOSTBIN_PORT=8080

# Optional Google sign-in. Create an OAuth client in Google Cloud Console,
# then add this redirect URI to the client:
# https://hostbin.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hostbin.example.com/auth/google/callback
